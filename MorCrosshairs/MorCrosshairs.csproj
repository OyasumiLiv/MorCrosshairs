<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <Title>Mor' Crosshairs</Title>
        <ModId>MorCrosshairs</ModId>
        <Description>Allows you to customize the survivors' crosshairs.</Description>
        <Copyright>MIT</Copyright>
        <PackageTags>QoL, Tweaks</PackageTags>
        <Authors>OyasumiLiv</Authors>
        <PackageProjectUrl>https://github.com/OyasumiLiv/MorCrosshairs</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/OyasumiLiv/MorCrosshairs/blob/master/LICENSE.md</PackageLicenseUrl>
        <RepositoryUrl>https://github.com/OyasumiLiv/MorCrosshairs</RepositoryUrl>
        <RepositoryType>Open Source</RepositoryType>
        <Company>OyasumiLiv</Company>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <Version>1.0.0</Version>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>Build\Stable\$(Company)-$(ModId)-$(Version)\BepInEx\plugins\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>Build\Debug\$(Company)-$(ModId)-$(Version)\BepInEx\plugins\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MMHOOK.RoR2" Version="2025.12.9" />
      <PackageReference Include="R2API" Version="5.0.5" />
      <PackageReference Include="R2API.Core" Version="5.3.0" />
      <PackageReference Include="RoR2.BepInEx.Analyzers" Version="1.0.8">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="RoR2BepInExPack" Version="1.43.0" />
      <PackageReference Include="Rune580.Mods.RiskOfRain2.RiskOfOptions" Version="2.8.6" />
    </ItemGroup>

</Project>
