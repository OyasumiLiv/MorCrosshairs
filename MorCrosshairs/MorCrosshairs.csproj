<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <Title>Mor' Crosshairs for RoR 2</Title>
        <Description>Adds the option to customize the survivors' crosshairs.</Description>
        <Copyright>MIT</Copyright>
        <PackageTags>QoL, Tweaks</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MMHOOK.RoR2" Version="2025.12.9" />
      <PackageReference Include="R2API" Version="5.0.5" />
      <PackageReference Include="R2API.Core" Version="5.3.0" />
      <PackageReference Include="RoR2.BepInEx.Analyzers" Version="1.0.8">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="RoR2BepInExPack" Version="1.43.0" />
      <PackageReference Include="Rune580.Mods.RiskOfRain2.RiskOfOptions" Version="2.8.6" />
    </ItemGroup>

</Project>
